# RDS configuration. Copy to .env and fill in.
# Every variable here is read by bin/ scripts, bootstrap/install.sh, or the dashboard.
# Precedence: .env > process environment > config/defaults.env.

# --- Paths -------------------------------------------------------------------
RDS_HOME=/absolute/path/to/rds
RDS_BUILDS_DIR=/absolute/path/to/rds/builds
RDS_INBOX_DIR=/absolute/path/to/rds/inbox
RDS_EVENTS_PATH=/absolute/path/to/rds/events.jsonl
RDS_DASHBOARD_CHAT_DIR=/absolute/path/to/rds/dashboard/chat
RDS_DASHBOARD_STATE_DIR=/absolute/path/to/rds/dashboard

# For production-like installs, keep mutable state outside the checkout:
# RDS_BUILDS_DIR=/var/lib/rds/builds
# RDS_INBOX_DIR=/var/lib/rds/inbox
# RDS_EVENTS_PATH=/var/lib/rds/events.jsonl
# RDS_DASHBOARD_CHAT_DIR=/var/lib/rds/dashboard-chat
# RDS_DASHBOARD_STATE_DIR=/var/lib/rds/dashboard-state

# --- Dashboard -----------------------------------------------------------------
# With no password or token the dashboard runs in setup mode: localhost only,
# with a banner, and 503 for everything else. Set both before exposing it.
RDS_DASHBOARD_USER=rds
RDS_DASHBOARD_PASSWORD=
RDS_DASHBOARD_TOKEN=
# PORT=4000

# --- Builder (coding agent) ----------------------------------------------------
# claude or codex. Settings in the dashboard can change the default later.
# RDS_INFERENCE_PROVIDER=claude
# Pinned in vendor/scaffold/templates/launch-build.sh; override only when
# intentionally A/B testing build quality.
# RDS_CLAUDE_MODEL=claude-opus-4-8

# --- Publishing on your own server (VPS) -----------------------------------------
# Set a domain and RDS publishes each passing build at https://<build>.<domain>.
# Needs wildcard DNS (*.<domain>) pointing at this server, Caddy, and systemd.
# Run "sudo ./bin/rds-vps-setup --user=<rds-user>" once. See docs/RUNNING_ON_A_VPS.md.
RDS_PUBLIC_DOMAIN=
# Dashboard address (default rds.<RDS_PUBLIC_DOMAIN>):
# RDS_DASHBOARD_HOST=rds.example.com
# Force a target instead of deriving it (vps when RDS_PUBLIC_DOMAIN is set, else zo):
# RDS_DEFAULT_DEPLOY_TARGET=vps
# Advanced: RDS_PUBLIC_SCHEME=https, RDS_VPS_SUPERVISOR=auto|systemd|process,
# RDS_VPS_PROXY=caddy|none, RDS_CADDY_SITES_DIR=/etc/caddy/rds.d,
# RDS_CADDYFILE=/etc/caddy/Caddyfile, RDS_CADDY_RELOAD_CMD=...
# Set to 0 if Postgres is managed by systemd or not needed (non-Rails stacks):
# RDS_MANAGE_POSTGRES=1
# RDS_PG_CLUSTER="16 main"
# Published Rails apps use the local Postgres socket as this OS user. To use a
# database server instead: RDS_DB_HOST, RDS_DB_USERNAME, RDS_DB_PASSWORD.

# --- Publishing on Zo -------------------------------------------------------------
# Zo owner/handle used for generated *.zocomputer.io preview URLs.
RDS_ZO_OWNER=
ZO_PUBLIC_PORT_RANGE_START=4000
ZO_PUBLIC_PORT_RANGE_END=4099
# ZO_PUBLIC_HOST=

# --- Notion (optional) ------------------------------------------------------------
# Notion MCP is preferred. A direct integration token is a fallback only.
# NOTION_INTEGRATION_TOKEN=

# --- Telegram completion and stuck-build alerts (optional) ---------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Defaults ----------------------------------------------------------------------
RDS_DEFAULT_DB=postgres
