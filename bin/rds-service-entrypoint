#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Load .env first so every setting below (Postgres management, port, Bun path)
# honors it.
if [[ -f "$ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT/.env"
  set +a
fi

LOGFILE="${RDS_POSTGRES_LOG:-${TMPDIR:-/tmp}/rds-postgres.log}"
[[ -d /dev/shm ]] && LOGFILE="${RDS_POSTGRES_LOG:-/dev/shm/rds-postgres.log}"
BUN="${BUN_BIN:-$(command -v bun || echo "$HOME/.bun/bin/bun")}"
PORT="${PORT:-4000}"

log() {
  printf '[%s] %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOGFILE" >&2
}

ensure_postgres() {
  # Rails builds need Postgres. Set RDS_MANAGE_POSTGRES=0 when the host runs
  # Postgres itself (systemd, managed DB) or does not build Rails apps.
  [[ "${RDS_MANAGE_POSTGRES:-1}" == "1" ]] || return 0
  if ! command -v pg_isready >/dev/null 2>&1; then
    log "WARN: Postgres tools not installed; Rails builds need PostgreSQL. Starting the dashboard anyway."
    return 0
  fi
  if pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1; then
    log "postgres already accepting connections on 127.0.0.1:5432"
    return 0
  fi

  local cluster="${RDS_PG_CLUSTER:-15 main}"
  log "postgres not ready; starting cluster $cluster"
  # shellcheck disable=SC2086
  pg_ctlcluster $cluster start >>"$LOGFILE" 2>&1 || true

  for _ in $(seq 1 30); do
    if pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1; then
      log "postgres ready"
      return 0
    fi
    sleep 1
  done

  log "WARN: postgres did not become ready; Rails builds will fail until it runs. Set RDS_MANAGE_POSTGRES=0 to skip this check."
  tail -20 "$LOGFILE" >&2 || true
  return 0
}

start_postgres_monitor() {
  (
    while sleep "${RDS_POSTGRES_MONITOR_INTERVAL:-15}"; do
      if ! pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1; then
        log "postgres readiness check failed; attempting restart"
        # shellcheck disable=SC2086
        pg_ctlcluster ${RDS_PG_CLUSTER:-15 main} start >>"$LOGFILE" 2>&1 || true
      fi
    done
  ) &
}

listener_pid_for_port() {
  ss -ltnp "sport = :$PORT" 2>/dev/null \
    | awk -F'pid=' 'NR>1 && $2 {split($2,a,","); print a[1]; exit}'
}

claim_dashboard_port() {
  local listener=""
  if curl -fsS --max-time 2 "http://127.0.0.1:$PORT/healthz" >/dev/null 2>&1; then
    listener="$(listener_pid_for_port || true)"
    if [[ "$listener" =~ ^[0-9]+$ && "$listener" != "$$" ]]; then
      log "dashboard already listening on port $PORT as pid $listener; replacing stale listener for supervised service"
      kill -TERM "$listener" 2>/dev/null || true
      for _ in $(seq 1 10); do
        kill -0 "$listener" 2>/dev/null || return 0
        sleep 0.3
      done
      log "dashboard listener pid $listener did not exit after TERM; killing"
      kill -KILL "$listener" 2>/dev/null || true
    fi
  fi
}

ensure_postgres
if [[ "${RDS_POSTGRES_MONITOR_AUTOSTART:-0}" == "1" ]]; then
  start_postgres_monitor
fi

if [[ -f /root/.zo_secrets ]]; then
  # Refresh short-lived Zo identity tokens before dashboard/watchdog launch.
  # The managed service env can contain an expired token from service creation.
  # shellcheck disable=SC1090
  source /root/.zo_secrets
fi

export RDS_ROOT="${RDS_ROOT:-$ROOT}"
export PORT

if [[ "${RDS_WATCHDOG_AUTOSTART:-1}" == "1" && -x "$ROOT/bin/rds-watchdog" ]]; then
  "$ROOT/bin/rds-watchdog" --status >/dev/null 2>&1 || \
    "$ROOT/bin/rds-watchdog" --detach >/dev/null 2>&1 || true
fi

cd "$ROOT/dashboard"
claim_dashboard_port
exec "$BUN" run src/server.ts
